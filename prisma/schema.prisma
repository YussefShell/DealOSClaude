generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Authentication & Users
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts              Account[]
  sessions              Session[]
  organizationMemberships OrganizationMember[]
  createdOrganizations  Organization[]       @relation("CreatedOrganizations")
  createdDeals          Deal[]               @relation("CreatedDeals")
  dealParticipations    DealParticipant[]
  uploadedDocuments     Document[]           @relation("UploadedDocuments")
  documentActivity      DocumentActivity[]
  qaThreadsAsked        QAThread[]           @relation("AskedThreads")
  qaResponses           QAResponse[]
  comments              Comment[]
  assignedTasks         Task[]
  notifications         Notification[]

  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Organizations (Multi-tenant)
model Organization {
  id               String             @id @default(cuid())
  name             String
  subscriptionTier SubscriptionTier   @default(FREE)
  maxDeals         Int                @default(5)
  maxStorage       BigInt             @default(10737418240) // 10GB in bytes
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      String

  createdBy        User               @relation("CreatedOrganizations", fields: [createdById], references: [id])
  members          OrganizationMember[]
  deals            Deal[]

  @@index([createdById])
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole          @default(MEMBER)
  joinedAt       DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// Deals
model Deal {
  id                String        @id @default(cuid())
  organizationId    String
  name              String
  targetCompany     String
  dealType          DealType
  status            DealStatus    @default(ACTIVE)
  estimatedCloseDate DateTime?
  closedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("CreatedDeals", fields: [createdById], references: [id])
  participants      DealParticipant[]
  folders           Folder[]
  documents         Document[]
  qaThreads         QAThread[]
  tasks             Task[]
  dealSettings      DealSettings?

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
}

enum DealType {
  ACQUISITION
  MERGER
  INVESTMENT
  JOINT_VENTURE
  ASSET_SALE
  OTHER
}

enum DealStatus {
  ACTIVE
  PAUSED
  CLOSED
  ARCHIVED
}

model DealSettings {
  id                    String   @id @default(cuid())
  dealId                String   @unique
  requireNDA            Boolean  @default(true)
  watermarkDownloads    Boolean  @default(true)
  allowBulkDownload     Boolean  @default(false)
  allowPrinting         Boolean  @default(false)
  sessionTimeout        Int      @default(3600) // seconds
  ipWhitelist           String[] // Array of allowed IP addresses
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deal                  Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model DealParticipant {
  id            String          @id @default(cuid())
  dealId        String
  userId        String
  role          DealRole
  ndaSigned     Boolean         @default(false)
  ndaSignedAt   DateTime?
  invitedAt     DateTime        @default(now())
  lastAccessAt  DateTime?

  deal          Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentPermissions DocumentPermission[]

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
}

enum DealRole {
  DEAL_OWNER
  SELLER_TEAM
  BUYER
  ADVISOR
  VIEW_ONLY
}

// Documents & Folders
model Folder {
  id              String   @id @default(cuid())
  dealId          String
  parentFolderId  String?
  name            String
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  parentFolder    Folder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders    Folder[] @relation("FolderHierarchy")
  documents       Document[]

  @@index([dealId])
  @@index([parentFolderId])
}

model Document {
  id                String              @id @default(cuid())
  folderId          String?
  dealId            String
  filename          String
  originalFilename  String
  fileSize          BigInt
  fileType          String
  mimeType          String
  s3Key             String              @unique
  s3Bucket          String
  version           Int                 @default(1)
  checksum          String
  uploadedById      String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  folder            Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  deal              Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy        User                @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  permissions       DocumentPermission[]
  activity          DocumentActivity[]
  aiExtractions     AIExtraction[]
  comments          Comment[]

  @@index([dealId])
  @@index([folderId])
  @@index([uploadedById])
  @@index([s3Key])
}

model DocumentPermission {
  id            String           @id @default(cuid())
  documentId    String
  participantId String
  canView       Boolean          @default(true)
  canDownload   Boolean          @default(false)
  canComment    Boolean          @default(false)
  grantedAt     DateTime         @default(now())

  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  participant   DealParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([documentId, participantId])
  @@index([documentId])
  @@index([participantId])
}

// Activity Tracking
model DocumentActivity {
  id          String              @id @default(cuid())
  documentId  String
  userId      String
  actionType  DocumentActionType
  duration    Int?                // seconds spent viewing
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime            @default(now())

  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
}

enum DocumentActionType {
  VIEW
  DOWNLOAD
  PRINT
  SHARE
  COMMENT
}

// AI Features
model AIExtraction {
  id              String   @id @default(cuid())
  documentId      String
  extractionType  ExtractionType
  extractedData   Json     // Flexible JSON field for various extraction types
  confidenceScore Float
  model           String   // Which AI model was used
  createdAt       DateTime @default(now())

  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([extractionType])
}

enum ExtractionType {
  DOCUMENT_CLASSIFICATION
  FINANCIAL_DATA
  CONTRACT_TERMS
  CORPORATE_INFO
  RISK_FLAGS
  EXECUTIVE_SUMMARY
  KEY_ENTITIES
}

// Q&A Module
model QAThread {
  id          String        @id @default(cuid())
  dealId      String
  question    String
  askerId     String
  status      QAStatus      @default(OPEN)
  priority    QAPriority    @default(NORMAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  deal        Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  asker       User          @relation("AskedThreads", fields: [askerId], references: [id])
  responses   QAResponse[]

  @@index([dealId])
  @@index([askerId])
  @@index([status])
}

enum QAStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum QAPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model QAResponse {
  id          String   @id @default(cuid())
  threadId    String
  response    String
  responderId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thread      QAThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  responder   User     @relation(fields: [responderId], references: [id])

  @@index([threadId])
  @@index([responderId])
}

// Comments on Documents
model Comment {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  content    String
  isInternal Boolean  @default(false) // Only visible to seller team
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([userId])
}

// Task Management
model Task {
  id          String      @id @default(cuid())
  dealId      String
  title       String
  description String?
  assigneeId  String
  status      TaskStatus  @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignee    User        @relation(fields: [assigneeId], references: [id])

  @@index([dealId])
  @@index([assigneeId])
  @@index([status])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  NEW_DOCUMENT
  DOCUMENT_VIEWED
  NEW_QUESTION
  QUESTION_ANSWERED
  ACCESS_GRANTED
  TASK_ASSIGNED
  DEAL_UPDATE
  SYSTEM
}
